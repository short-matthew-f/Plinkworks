{
  "name": "plinkworks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plinkworks: a physics sandbox that makes music. Place parts on a tilted table; every contact becomes a note locked to a scale and a beat.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "^0.21.0",
    "tone": "^15.1.22"
  }
}
